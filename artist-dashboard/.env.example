# Artist Dashboard Environment Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (supports individual keys OR cloud DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=artiqpc
# Optional cloud database connection string:
# DATABASE_URL=mysql://user:password@host:port/dbname

# Authentication & Session Security
SESSION_SECRET=replace_with_a_secure_session_secret_key_2026
CORS_ORIGIN=http://localhost:3001

# Optional persistent uploads directory for production containers:
# UPLOADS_DIR=/var/data/uploads
