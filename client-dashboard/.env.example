# Client Dashboard Environment Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (supports individual keys OR cloud DATABASE_URL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=artiqpc
# Optional cloud database connection string (e.g. Railway, Render, Supabase, Clever Cloud):
# DATABASE_URL=mysql://user:password@host:port/dbname

# Authentication & Security
JWT_SECRET=replace_with_a_long_random_jwt_secret_64_characters_recommended
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Services & Uploads
ARTIST_SERVER_URL=http://localhost:3000
ARTIST_UPLOADS_PATH=../artist-dashboard/public/uploads
# Optional persistent storage directory for cloud uploads:
# UPLOADS_DIR=/var/data/uploads
